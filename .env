# Конфигурация Telegram бота для проверки VPN ключей
# ⚠️ ВАЖНО: Используйте .env.example как шаблон!
# ❌ НИКОГДА не храните реальные токены в этом файле!

# Токен вашего Telegram бота (полученный от @BotFather)
# Используйте переменные окружения или GitHub Secrets
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата для отправки результатов (можно получить через @userinfobot)
CHAT_ID=your_chat_id_here

# Имя администратора (для получения уведомлений)
ADMIN_USERNAME=admin

# Путь к файлам с ключами
KEYS_DIR=./checked

# Путь для сохранения истории проверок
HISTORY_DIR=./checked

# Имя файла истории
HISTORY_FILE=history.json

# Лимит ключей для проверки за один раз
BATCH_LIMIT=10

# Задержка между проверками одного ключа (в секундах)
KEY_CHECK_DELAY=1

# Интервал между массовыми проверками (в секундах)
BATCH_INTERVAL=300
