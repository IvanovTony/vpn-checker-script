# Конфигурация Telegram бота для проверки VPN ключей
# Скопируйте этот файл в .env и заполните своими данными

# Токен вашего Telegram бота (полученный от @BotFather)
# Пример: 1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ123456789
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Основные настройки скрипта
BASE_DIR=checked
MY_CHANNEL=@your_channel_name

# Настройки производительности
TIMEOUT=5
THREADS=40
CACHE_HOURS=12
CHUNK_LIMIT=1000
MAX_KEYS_TO_CHECK=15000

# Настройки GitHub
GITHUB_USER_REPO=your_username/your_repo_name
GITHUB_BRANCH=main

# Опционально: Chat ID для уведомлений (не требуется для базовой функциональности)
# CHAT_ID=your_chat_id_here
